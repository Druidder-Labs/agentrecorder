[0.005,"o","m\u001b[K\r\r\n\u001b[6G\u001b[37m\u001b[2m 14\u001b[10G\u001b[22m \u001b[15Gparser\u001b[22G=\u001b[24Gargparse.ArgumentParser(description=\u001b[92m\"Print\u001b[67Ga\u001b[69Ggreeting.\"\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[91m 12\u001b[10G-\u001b[37m\u001b[2m \u001b[15Gparser.add_argument(\"name\",\u001b[43Gnargs=\"?\",\u001b[54Gdefault=\"World\",\u001b[71Ghelp=\"who\u001b[81Gto\u001b[84Ggreet\u001b[90G(default:\u001b[100GWorld)\")\u001b[22m\u001b[39m\r\r\n\u001b[6G\u001b[92m 15\u001b[10G+\u001b[37m \u001b[15Ggroup\u001b[21G=\u001b[23Gparser.add_mutually_exclusive_group()\u001b[39m\r\r\n\u001b[6G\u001b[92m 16\u001b[10G+\u001b[37m \u001b[15Ggroup.add_argument(\u001b[92m\"name\"\u001b[37m,\u001b[42Gnargs=\u001b[92m\"?\"\u001b[37m,\u001b[53G\u001b[96mhelp\u001b[37m=\u001b[92m\"who\u001b[63Gto\u001b[66Ggreet\u001b[72G(default:\u001b[82GWorld)\"\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[92m 17\u001b[10G+\u001b[37m \u001b[15Ggroup.add_argument(\u001b[92m\"--name\"\u001b[37m,\u001b[44Gdest=\u001b[92m\"name_opt\"\u001b[37m,\u001b[61Gmetavar=\u001b[92m\"NAME\"\u001b[37m,\u001b[77G\u001b[96mhelp\u001b[37m=\u001b[92m\"same\u001b[88Gas\u001b[91Gthe\u001b[95Gpositional\u001b[106Gname\"\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 18\u001b[10G\u001b[22m \u001b[15Gargs\u001b[20G=\u001b[22Gparser.parse_args(argv)\u001b[39m\r\r\n\u001b[6G\u001b[91m 14\u001b[10G-\u001b[37m\u001b[2m \u001b[15Gprint(greet(args.name))\u001b[22m\u001b[39m\r\r\n\u001b[6G\u001b[92m 19\u001b[10G+\u001b[37m \u001b[15G\u001b[96mprint\u001b[37m(greet(args.name\u001b[37G\u001b[95mor\u001b[37m args.name_opt\u001b[54G\u001b[95mor\u001b[37m \u001b[92m\"World\"\u001b[37m))\u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 20\u001b[10G\u001b[22m \u001b[15G\u001b[95mreturn\u001b[37m \u001b[94m0\u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 21\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 22\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[92m 23\u001b[10G+\u001b[96mclass\u001b[37m \u001b[93mGreetTest\u001b[37m(unittest.TestCase):\u001b[39m\r\r\n\u001b[6G\u001b[92m 24\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_default\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 25\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(greet(),\u001b[45G\u001b[92m\"Hello\u001b[52GWorld!\"\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[92m 26\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 27\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_name\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 28\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(greet(\u001b[92m\"Ana\"\u001b[37m),\u001b[50G\u001b[92m\"Hello\u001b[57GAna!\"\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[92m 29\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 30\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 31\u001b[10G+\u001b[96mclass\u001b[37m \u001b[93mMainTest\u001b[37m(unittest.TestCase):\u001b[39m\r\r\n\u001b[6G\u001b[92m 32\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mrun_main\u001b[37m(self,\u001b[34Gargv):\u001b[39m\r\r\n\u001b[6G\u001b[92m 33\u001b[10G+\u001b[37m \u001b[19Gout\u001b[23G=\u001b[25Gio.StringIO()\u001b[39m\r\r\n\u001b[6G\u001b[92m 34\u001b[10G+\u001b[37m \u001b[19G\u001b[95mwith\u001b[37m contextlib.redirect_stdout(out):\u001b[39m\r\r\n\u001b[6G\u001b[92m 35\u001b[10G+\u001b[37m \u001b[23Gcode\u001b[28G=\u001b[30Gmain(argv)\u001b[39m\r\r\n\u001b[6G\u001b[92m 36\u001b[10G+\u001b[37m \u001b[19G\u001b[95mreturn\u001b[37m code,\u001b[32Gout.getvalue()\u001b[39m\r\r\n\u001b[6G\u001b[92m 37\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 38\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_no_args\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 39\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(self.run_main([]),\u001b[55G(\u001b[94m0\u001b[37m,\u001b[59G\u001b[92m\"Hello\u001b[66GWorld!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[6G\u001b[92m 40\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 41\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 42\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(self.run_main([\u001b[92m\"Ana\"\u001b[37m]),\u001b[60G(\u001b[94m0\u001b[37m,\u001b[64G\u001b[92m\"Hello\u001b[71GAna!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[6G\u001b[92m 43\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 44\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name_flag\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 45\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(self.run_main([\u001b[92m\"--name\"\u001b[37m,\u001b[61G\u001b[92m\"Ada\"\u001b[37m]),\u001b[70G(\u001b[94m0\u001b[37m,\u001b[74G\u001b[92m\"Hello\u001b[81GAda!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[6G\u001b[92m 46\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 47\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_both_forms_rejected\u001b[37m(self):\u001b[39m\r\r\n\u001b[6G\u001b[92m 48\u001b[10G+\u001b[37m \u001b[19G\u001b[95mwith\u001b[37m contextlib.redirect_stderr(io.StringIO()):\u001b[39m\r\r\n\u001b[6G\u001b[92m 49\u001b[10G+\u001b[37m \u001b[23G\u001b[95mwith\u001b[37m self.assertRaises(SystemExit)\u001b[58G\u001b[95mas\u001b[37m ctx:\u001b[39m\r\r\n\u001b[6G\u001b[92m 50\u001b[10G+\u001b[37m \u001b[27Gmain([\u001b[92m\"Ana\"\u001b[37m,\u001b[40G\u001b[92m\"--name\"\u001b[37m,\u001b[50G\u001b[92m\"Ada\"\u001b[37m])\u001b[39m\r\r\n\u001b[6G\u001b[92m 51\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(ctx.exception.code,\u001b[56G\u001b[94m2\u001b[37m)\u001b[39m\r\r\n\u001b[6G\u001b[92m 52\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[92m 53\u001b[10G+\u001b[37m \u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 54\u001b[10G\u001b[22m \u001b[95mif\u001b[37m __name__\u001b[23G==\u001b[26G\u001b[92m\"__main__\"\u001b[37m:\u001b[39m\r\r\n\u001b[6G\u001b[37m\u001b[2m 55\u001b[10G\u001b[22m \u001b[15Gsys.exit(main())\u001b[39m\r\r\n\r\r\n\u001b[37m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(README)\r\r\n\r\r\n\u001b[37m⏺\u001b[3G\u001b[39m\u001b[1mBash\u001b[22m(cat\u001b[12Gtest_hello.py\u001b[26G|\u001b[28Ghead\u001b[33G-5\u001b[36G&&\u001b[39Grm\u001b[42Gtest_hello.py)\r\r\n\u001b[37m \u001b[3G⎿\u001b[5G Waiting…\u001b[39m\r\r\n\r\r\n\u001b[91m✳\u001b[3G\u001b[93mSwooping…\u001b[91m \u001b[37m(8s\u001b[17G·\u001b[19G↓\u001b[21G846\u001b[25Gtokens)\u001b[39m\r\r\n\r\r\n\u001b[37m────────────────────────────────────"]
