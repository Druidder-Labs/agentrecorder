[0.011,"o","\u001b[?25l\u001b[2D\u001b[3B\r\u001b[5C\u001b[13A\u001b[2m\u001b[37m  9  \r\u001b[1B\u001b[39m\u001b[22m \u001b[3G   \u001b[2m\u001b[37m 10  \u001b[96mdef\u001b[37m \u001b[93mmain\u001b[37m(argv=\u001b[94mNone\u001b[37m):\r\u001b[1B\u001b[39m\u001b[22m     \u001b[2m\u001b[37m 11      parser = argparse.ArgumentParser(description=\u001b[92m\"Print a greeting.\"\u001b[37m)\r\u001b[5C\u001b[1B\u001b[91m 12 -\u001b[37m    parser.add_argument(\"name\", nargs=\"?\", default=\"World\", help=\"who to greet (default: World)\")      \r\u001b[1B\u001b[39m\u001b[22m \u001b[3G   \u001b[2m\u001b[92m 12 +\u001b[37m    group = parser.add_mutually_exclusive_group()                                                      \r\u001b[1B\u001b[39m\u001b[22m     \u001b[2m\u001b[92m 13 +\u001b[37m    group.add_argument(\u001b[92m\"name\"\u001b[37m, nargs=\u001b[92m\"?\"\u001b[37m, \u001b[96mhelp\u001b[37m=\u001b[92m\"who to greet (default: World)\"\u001b[37m)                        \r\u001b[5C\u001b[1B\u001b[92m 14 +\u001b[37m    group.add_argument(\u001b[92m\"--name\"\u001b[37m, dest=\u001b[92m\"name_opt\"\u001b[37m, metavar=\u001b[92m\"NAME\"\u001b[37m, \u001b[96mhelp\u001b[37m=\u001b[92m\"same as the positional name\"\u001b[37m)  \r\u001b[1B\u001b[39m\u001b[22m \u001b[3G   \u001b[2m\u001b[37m 15      args = parser.parse_args(argv)\r\u001b[5C\u001b[1B\u001b[91m 14 -\u001b[37m    print(greet(args.name))                                                                            \r\u001b[1B\u001b[39m\u001b[22m     \u001b[2m\u001b[92m 16 +\u001b[37m    \u001b[96mprint\u001b[37m(greet(args.name \u001b[95mor\u001b[37m args.name_opt \u001b[95mor\u001b[37m \u001b[92m\"World\"\u001b[37m))                                                \u001b[39m\u001b[22m\u001b[K\r\u001b[1B  \u001b[6G\u001b[2m\u001b[37m 17      \u001b[95mreturn\u001b[37m \u001b[94m0\r\u001b[1B\u001b[39m\u001b[22m     \u001b[2m\u001b[37m 18  \u001b[39m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[2m\u001b[37m 19  \u001b[39m\u001b[22m\u001b[K\r\r\n\r\r\n\u001b[91m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(test_hello.py)\r\r\n\u001b[37m \u001b[3G⎿\u001b[5G User\u001b[11Grejected\u001b[20Gupdate\u001b[27Gto\u001b[30G\u001b[1mtest_hello.py\u001b[22m\u001b[39m\r\r\n\u001b[6G\u001b[2m\u001b[37m 26\u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name\u001b[37m(self):\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[37m 27\u001b[19Gself.assertEqual(self.run_main([\u001b[92m\"Ana\"\u001b[37m]),\u001b[60G(\u001b[94m0\u001b[37m,\u001b[64G\u001b[92m\"Hello\u001b[71GAna!\\n\"\u001b[37m))\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[37m 28\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 29\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name_flag\u001b[37m(self):\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 30\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(self.run_main([\u001b[92m\"--name\"\u001b[37m,\u001b[61G\u001b[92m\"Ada\"\u001b[37m]),\u001b[70G(\u001b[94m0\u001b[37m,\u001b[74G\u001b[92m\"Hello\u001b[81GAda!\\n\"\u001b[37m))\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[37m 31\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 32\u001b[10G+\u001b[37m \u001b[15G\u001b[96mdef\u001b[37m \u001b[93mtest_both_forms_rejected\u001b[37m(self):\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 33\u001b[10G+\u001b[37m \u001b[19G\u001b[95mwith\u001b[37m contextlib.redirect_stderr(io.StringIO()):\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 34\u001b[10G+\u001b[37m \u001b[23G\u001b[95mwith\u001b[37m self.assertRaises(SystemExit)\u001b[58G\u001b[95mas\u001b[37m ctx:\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 35\u001b[10G+\u001b[37m \u001b[27Gmain([\u001b[92m\"Ana\"\u001b[37m,\u001b[40G\u001b[92m\"--name\"\u001b[37m,\u001b[50G\u001b[92m\"Ada\"\u001b[37m])\u001b[39m\u001b[22m\r\r\n\u001b[6G\u001b[2m\u001b[92m 36\u001b[10G+\u001b[37m \u001b[19Gself.assertEqual(ctx.exception.code,\u001b[56G\u001b[94m2\u001b[37m)\u001b[39m