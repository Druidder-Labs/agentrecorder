[0.003,"o","\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[94m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1C\u001b[1B\u001b[1mOverwrite file\r\u001b[1B\u001b[22m\u001b[39m \u001b[37mhello.py\u001b[39m\u001b[K\r\u001b[1B\u001b[37m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\r\u001b[1B\u001b[39m \u001b[37m\u001b[2m 1 \u001b[22m \u001b[90m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[37m\u001b[2m 2 \u001b[22m \u001b[95mimport\u001b[37m argparse\u001b[39m\u001b[K\r\r\n\u001b[2G\u001b[92m 3\u001b[5G+\u001b[95mimport\u001b[37m contextlib\u001b[39m\r\r\n\u001b[2G\u001b[92m 4\u001b[5G+\u001b[95mimport\u001b[37m io\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 5\u001b[5G\u001b[22m \u001b[95mimport\u001b[37m sys\u001b[39m\r\r\n\u001b[2G\u001b[92m 6\u001b[5G+\u001b[95mimport\u001b[37m unittest\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 7\u001b[5G\u001b[22m \u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 8\u001b[5G\u001b[22m \u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 9\u001b[5G\u001b[22m \u001b[96mdef\u001b[37m \u001b[93mgreet\u001b[37m(name=\u001b[92m\"World\"\u001b[37m):\u001b[39m\r\r\n\u001b[2G\u001b[37m...\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 12\u001b[6G\u001b[22m \u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 13\u001b[6G\u001b[22m \u001b[96mdef\u001b[37m \u001b[93mmain\u001b[37m(argv=\u001b[94mNone\u001b[37m):\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 14\u001b[6G\u001b[22m \u001b[11Gparser\u001b[18G=\u001b[20Gargparse.ArgumentParser(description=\u001b[92m\"Print\u001b[63Ga\u001b[65Ggreeting.\"\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[91m 12\u001b[6G-\u001b[37m\u001b[2m \u001b[11Gparser.add_argument(\"name\",\u001b[39Gnargs=\"?\",\u001b[50Gdefault=\"World\",\u001b[67Ghelp=\"who\u001b[77Gto\u001b[80Ggreet\u001b[86G(default:\u001b[96GWorld)\")\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[92m 15\u001b[6G+\u001b[37m \u001b[11Ggroup\u001b[17G=\u001b[19Gparser.add_mutually_exclusive_group()\u001b[39m\r\r\n\u001b[2G\u001b[92m 16\u001b[6G+\u001b[37m \u001b[11Ggroup.add_argument(\u001b[92m\"name\"\u001b[37m,\u001b[38Gnargs=\u001b[92m\"?\"\u001b[37m,\u001b[49G\u001b[96mhelp\u001b[37m=\u001b[92m\"who\u001b[59Gto\u001b[62Ggreet\u001b[68G(default:\u001b[78GWorld)\"\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[92m 17\u001b[6G+\u001b[37m \u001b[11Ggroup.add_argument(\u001b[92m\"--name\"\u001b[37m,\u001b[40Gdest=\u001b[92m\"name_opt\"\u001b[37m,\u001b[57Gmetavar=\u001b[92m\"NAME\"\u001b[37m,\u001b[73G\u001b[96mhelp\u001b[37m=\u001b[92m\"same\u001b[84Gas\u001b[87Gthe\u001b[91Gpositional\u001b[102Gname\"\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 18\u001b[6G\u001b[22m \u001b[11Gargs\u001b[16G=\u001b[18Gparser.parse_args(argv)\u001b[39m\r\r\n\u001b[2G\u001b[91m 14\u001b[6G-\u001b[37m\u001b[2m \u001b[11Gprint(greet(args.name))\u001b[22m\u001b[39m\r\r\n\u001b[2G\u001b[92m 19\u001b[6G+\u001b[37m \u001b[11G\u001b[96mprint\u001b[37m(greet(args.name\u001b[33G\u001b[95mor\u001b[37m args.name_opt\u001b[50G\u001b[95mor\u001b[37m \u001b[92m\"World\"\u001b[37m))\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 20\u001b[6G\u001b[22m \u001b[11G\u001b[95mreturn\u001b[37m \u001b[94m0\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 21\u001b[6G\u001b[22m \u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 22\u001b[6G\u001b[22m \u001b[39m\r\r\n\u001b[2G\u001b[92m 23\u001b[6G+\u001b[96mclass\u001b[37m \u001b[93mGreetTest\u001b[37m(unittest.TestCase):\u001b[39m\r\r\n\u001b[2G\u001b[92m 24\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_default\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 25\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(greet(),\u001b[41G\u001b[92m\"Hello\u001b[48GWorld!\"\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[92m 26\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 27\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_name\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 28\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(greet(\u001b[92m\"Ana\"\u001b[37m),\u001b[46G\u001b[92m\"Hello\u001b[53GAna!\"\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[92m 29\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 30\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 31\u001b[6G+\u001b[96mclass\u001b[37m \u001b[93mMainTest\u001b[37m(unittest.TestCase):\u001b[39m\r\r\n\u001b[2G\u001b[92m 32\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mrun_main\u001b[37m(self,\u001b[30Gargv):\u001b[39m\r\r\n\u001b[2G\u001b[92m 33\u001b[6G+\u001b[37m \u001b[15Gout\u001b[19G=\u001b[21Gio.StringIO()\u001b[39m\r\r\n\u001b[2G\u001b[92m 34\u001b[6G+\u001b[37m \u001b[15G\u001b[95mwith\u001b[37m contextlib.redirect_stdout(out):\u001b[39m\r\r\n\u001b[2G\u001b[92m 35\u001b[6G+\u001b[37m \u001b[19Gcode\u001b[24G=\u001b[26Gmain(argv)\u001b[39m\r\r\n\u001b[2G\u001b[92m 36\u001b[6G+\u001b[37m \u001b[15G\u001b[95mreturn\u001b[37m code,\u001b[28Gout.getvalue()\u001b[39m\r\r\n\u001b[2G\u001b[92m 37\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 38\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_no_args\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 39\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(self.run_main([]),\u001b[51G(\u001b[94m0\u001b[37m,\u001b[55G\u001b[92m\"Hello\u001b[62GWorld!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[2G\u001b[92m 40\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 41\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 42\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(self.run_main([\u001b[92m\"Ana\"\u001b[37m]),\u001b[56G(\u001b[94m0\u001b[37m,\u001b[60G\u001b[92m\"Hello\u001b[67GAna!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[2G\u001b[92m 43\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 44\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_with_name_flag\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 45\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(self.run_main([\u001b[92m\"--name\"\u001b[37m,\u001b[57G\u001b[92m\"Ada\"\u001b[37m]),\u001b[66G(\u001b[94m0\u001b[37m,\u001b[70G\u001b[92m\"Hello\u001b[77GAda!\\n\"\u001b[37m))\u001b[39m\r\r\n\u001b[2G\u001b[92m 46\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 47\u001b[6G+\u001b[37m \u001b[11G\u001b[96mdef\u001b[37m \u001b[93mtest_both_forms_rejected\u001b[37m(self):\u001b[39m\r\r\n\u001b[2G\u001b[92m 48\u001b[6G+\u001b[37m \u001b[15G\u001b[95mwith\u001b[37m contextlib.redirect_stderr(io.StringIO()):\u001b[39m\r\r\n\u001b[2G\u001b[92m 49\u001b[6G+\u001b[37m \u001b[19G\u001b[95mwith\u001b[37m self.assertRaises(SystemExit)\u001b[54G\u001b[95mas\u001b[37m ctx:\u001b[39m\r\r\n\u001b[2G\u001b[92m 50\u001b[6G+\u001b[37m \u001b[23Gmain([\u001b[92m\"Ana\"\u001b[37m,\u001b[36G\u001b[92m\"--name\"\u001b[37m,\u001b[46G\u001b[92m\"Ada\"\u001b[37m])\u001b[39m\r\r\n\u001b[2G\u001b[92m 51\u001b[6G+\u001b[37m \u001b[15Gself.assertEqual(ctx.exception.code,\u001b[52G\u001b[94m2\u001b[37m)\u001b[39m\r\r\n\u001b[2G\u001b[92m 52\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[92m 53\u001b[6G+\u001b[37m \u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 54\u001b[6G\u001b[22m \u001b[95mif\u001b[37m __name__\u001b[19G==\u001b[22G\u001b[92m\"__main__\"\u001b[37m:\u001b[39m\r\r\n\u001b[2G\u001b[37m\u001b[2m 55\u001b[6G\u001b[22m \u001b[11Gsys.exit(main())\u001b[39m\r\r\n\u001b[37m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[39m\r\r\n\u001b[2GDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Goverwrite\u001b[27G\u001b[1mhello.py\u001b[22m?\r\r\n\u001b[2G\u001b[94m❯\u001b[4G\u001b[37m1.\u001b[7G\u001b[94mYes\u001b[39m\r\r\n\u001b[4G\u001b[37m2.\u001b[7G\u001b[39mYes,\u001b[12Gand\u001b[16Gswitch\u001b[23Gto\u001b[26G\u001b[1maccept\u001b[33Gedits\u001b[39G(auto-approve\u001b[53Gfile\u001b[58Gedits\u001b[64Gand\u001b[68Gcommon\u001b[75Gfile\u001b[80Gcommands)\u001b[90G\u001b[22mfor\u001b[94Gthis\u001b[99Gsession\u001b[107G\u001b[1m(shift+tab)\u001b[22m\r\r\n\u001b[4G\u001b[37m3.\u001b[7G\u001b[39mNo\r\r\n\r\r\n\u001b[2G\u001b[37mEsc\u001b[6Gto\u001b[9Gcancel\u001b[16G·\u001b[18GTab\u001b[22Gto\u001b[25Gamend\u001b[39m\r\r\n\u001b[1C\u001b[5A"]
[1.139,"o","\u001b[1D\u001b[5B\r\u001b[1C\u001b[39A\u001b[37m\u001b[2m 22 \u001b[22m \u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[92m3\u001b[7G\u001b[96mclass\u001b[13G\u001b[93mGreetTest\u001b[37m(unittest.TestCase):              \r\u001b[3C\u001b[1B\u001b[92m4\u001b[11G\u001b[96mdef\u001b[15G\u001b[93mtest_default\u001b[37m(self):\r\u001b[3C\u001b[1B\u001b[92m5\u001b[11G\u001b[37m   \u001b[15Gself.assertEqual(greet(),\u001b[41G\u001b[92m\"Hello World!\"\u001b[37m)\r\u001b[3C\u001b[1B\u001b[92m6\u001b[15G\u001b[37m                              \u001b[46G             \r\u001b[3C\u001b[1B\u001b[92m7\u001b[11G\u001b[96mdef\u001b[15G\u001b[93mtest_name\u001b[37m(self):\r\u001b[2C\u001b[1B\u001b[92m28\u001b[15G\u001b[37mself.assertEqual(greet(\u001b[92m\"Ana\"\u001b[37m),\u001b[46G\u001b[92m\"Hello Ana!\"\u001b[37m)\r\u001b[2C\u001b[1B\u001b[92m29\u001b[7G\u001b[37m     \u001b[13G                            \r\u001b[3C\u001b[1B\u001b[92m0\u001b[11G\u001b[37m   \u001b[15G              \u001b[30G      \r\u001b[3C\u001b[1B\u001b[92m1\u001b[7G\u001b[96mclass\u001b[13G\u001b[93mMainTest\u001b[37m(uni\u001b[26Gtest.TestCase):\r\u001b[3C\u001b[1B\u001b[92m2\u001b[11G\u001b[96mdef\u001b[15G\u001b[93mrun_main\u001b[37m(self, a\u001b[32Ggv):                \r\u001b[3C\u001b[1B\u001b[92m3\u001b[15G\u001b[37mout\u001b[19G= io.StringIO()  \r\u001b[3C\u001b[1B\u001b[92m4\u001b[15G\u001b[95mwi\u001b[18Gh\u001b[37m contextlib.redirect_stdout(out):\r\u001b[3C\u001b[1B\u001b[92m5\u001b[19G\u001b[37mcode\u001b[24G=\u001b[26Gmain(argv)\r\u001b[3C\u001b[1B\u001b[92m6\u001b[11G\u001b[37m   \u001b[15G\u001b[95mreturn\u001b[37m code, out.getvalue()\r\u001b[3C\u001b[1B\u001b[92m7\u001b[15G\u001b[37m                                   \u001b[51G   \u001b[55G                  \r\u001b[2C\u001b[1B\u001b[92m38\u001b[11G\u001b[96mdef\u001b[15G\u001b[93mtest_no_args\u001b[37m(self):\r\u001b[2C\u001b[1B\u001b[92m39\u001b[11G\u001b[37m   \u001b[15Gself.assertEqual(self.run_main([]),\u001b[51G(\u001b[94m