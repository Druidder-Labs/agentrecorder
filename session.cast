[0.128,"o","\u001b[?25l\u001b[2D\u001b[4B\r\u001b[7A\u001b[97m⏺\u001b[3G\u001b[39mThat line makes \u001b[94mmain()\u001b[39m run only when\u001b[40Gyou\u001b[44Gstart\u001b[50Gthe\u001b[54Gfile\u001b[59Gyourself,\u001b[69Gnot\u001b[73Gwhen\u001b[78Ganother\u001b[86Gprogram\u001b[94Gloads\u001b[100Git.\r\u001b[2B  Python gives every file a variable called \u001b[94m__name__\u001b[39m:\u001b[K\r\u001b[1B  -\u001b[5GWhen\u001b[10Gyou\u001b[14Grun\u001b[18G\u001b[94mpython3 hello.py\u001b[39m,\u001b[36Git\u001b[39Gis\u001b[42Gset\u001b[46Gto\u001b[49G\u001b[94m\"__main__\"\u001b[39m.\u001b[61GThe\u001b[65Gcheck\u001b[71Gis\u001b[74Gtrue,\u001b[80Gso\u001b[83G\u001b[94mmain()\u001b[90G\u001b[39mruns\u001b[95Gand\u001b[99Gprints\u001b[106Gthe\u001b[110Ggreeting.\r\u001b[1B  - When another program imports the file, it is set to the file's name, \u001b[94m\"hello\"\u001b[39m. The check is false, so only the\u001b[K\r\u001b[2C\u001b[1B  functions and test classes get defined and nothing\u001b[56Gprints.\u001b[81G\u001b[K\r\u001b[100C\u001b[1B\u001b[K\r\r\n\u001b[3GThe\u001b[7Gtests\u001b[13Gneed\u001b[18Gthis\u001b[23Gbecause\u001b[31G\u001b[94mpython3\u001b[39G-m\u001b[42Gunittest\u001b[51Ghello\u001b[57G\u001b[39mimports\u001b[65G\u001b[94mhello.py\u001b[74G\u001b[39mto\u001b[77Gfind\u001b[82Gthe\u001b[86Gtests.\u001b[93GWithout\u001b[101Gthe\u001b[105Gguard,\u001b[112G\u001b[94mmain()\u001b[39m\r\r\n\u001b[3Gwould\u001b[9Grun\u001b[13Gduring\u001b[20Gthat\u001b[25Gimport.\u001b[33GIt\u001b[36Gwould\u001b[42Gread\u001b[47Gthe\u001b[51Gtest\u001b[56Grunner's\u001b[65Gown\u001b[69Gcommand\u001b[77Gline\u001b[82Gand\u001b[86Gstop\u001b[91Gon\u001b[94G\u001b[94m-v\u001b[97G\u001b[39mbefore\u001b[104Gany\u001b[108Gtest\u001b[113Gran.\r\r\n\r\r\n\u001b[3GI\u001b[5Gchecked\u001b[13Gthis\u001b[18Gon\u001b[21Ga\u001b[23Gcopy\u001b[28Gof\u001b[31Gthe\u001b[35Gfile\u001b[40Gin\u001b[43Gmy\u001b[46Gscratch\u001b[54Gfolder,\u001b[62Gwith\u001b[67Gthe\u001b[71Gguard\u001b[77Greplaced\u001b[86Gby\u001b[89G\u001b[94mif\u001b[92GTrue:\u001b[39m:\r\r\n\u001b[3G-\u001b[5G\u001b[94mpython3\u001b[13G-c\u001b[16G'import\u001b[24Ghello'\u001b[31G\u001b[39mprinted\u001b[39G\u001b[94mHello,\u001b[46GWorld!\u001b[53G\u001b[39mjust\u001b[58Gfrom\u001b[63Gthe\u001b[67Gimport.\r\r\n\u001b[3G-\u001b[5G\u001b[94mpython3\u001b[13G-m\u001b[16Gunittest\u001b[25G-v\u001b[28Ghello\u001b[34G\u001b[39mfailed\u001b[41Gwith\u001b[46G\u001b[94merror:\u001b[53Gunrecognized\u001b[66Garguments:\u001b[77G-v\u001b[39m,\u001b[81Gexit\u001b[86Gcode\u001b[91G2,\u001b[94Gand\u001b[98Gran\u001b[102Gno\u001b[105Gtests.\r\r\n\r\r\n\u001b[3GYour\u001b[8Greal\u001b[13G\u001b[94mhello.py\u001b[22G\u001b[39mwas\u001b[26Gnot\u001b[30Gtouched.\r\r\n\r\r\n\u001b[91m✽\u001b[3G\u001b[93mDetermining…\u001b[91m \u001b[37m(running\u001b[25GStop\u001b[30Ghooks…\u001b[37G0/2\u001b[41G·\u001b[43G11s\u001b[47G·\u001b[49G↓\u001b[51G495\u001b[55Gtokens)\u001b[39m\r\r\n\r\r\n\u001b[37m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[37m❯ \u001b[39m\r\r\n\u001b[37m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[37m⏸\u001b[5Gmanual\u001b[12Gmode\u001b[17Gon\u001b[20G·\u001b[22Gesc\u001b[26Gto\u001b[29Ginterrupt\u001b[39G·\u001b[41G←\u001b[43G2\u001b[45Gagents\u001b[81G\u001b[92m✔\u001b[83GUpdate\u001b[90Ginstalled\u001b[100G·\u001b[102GRestart\u001b[110Gto\u001b[113Gupdate\u001b[39m\r\r\n\u001b[101G\u001b[37m◐\u001b[103Gmedium\u001b[110G·\u001b[112G/effort\u001b[39m\r\r\n\u001b[2C\u001b[4A\u001b[?25h"]
